EMBEDDING_MODEL_NAME = "nomic-embed-text:latest"  # Change this to try different models

print(f"Loading Ollama embedding model ({EMBEDDING_MODEL_NAME})...")
try:
    embedding_model = OllamaEmbeddings(model=EMBEDDING_MODEL_NAME)
